+    try:
+        rgb = upload(client, R / f'rgb/{split}/{stem}.jpg', "rgb")
+        th = upload(client, R / f'thermal/{split}/{stem}.jpg', "thermal")
+        messages = build_messages(stem, split, rgb, th)
+        _, turns = loop(client, messages, verbose=verbose)
+        dets, r = commit(client, messages)
+        turns.append(dict(i="commit", stop=r.stop_reason,
+                          inp=r.usage.input_tokens, out=r.usage.output_tokens,
+                          cache_read=getattr(r.usage, "cache_read_input_tokens", 0) or 0,
+                          bash=0, attach=0))
+        return dets, turns
+    finally:
+        # uploads persist workspace-wide; without this they accumulate
+        for f in (rgb, th):
+            if f is not None:
+                try:
+                    client.beta.files.delete(f.id)
+                except Exception:
